# SPA routing para o front-end React (Hostinger / Apache / LiteSpeed).
# Todas as rotas que não forem arquivos reais caem no index.html, para que
# /admin e /p/:slug funcionem ao recarregar a página ou em links diretos.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não reescrever arquivos e pastas que existem de verdade.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Demais rotas → index.html (roteamento do lado do cliente).
  RewriteRule ^ index.html [L]
</IfModule>

# Cache dos assets versionados (hash no nome do arquivo).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# index.html nunca deve ser cacheado (para publicar novas versões na hora).
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
