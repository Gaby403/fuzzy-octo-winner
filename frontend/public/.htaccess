# SPA routing para o front-end React (Hostinger / Apache / LiteSpeed).
# As rotas HTML passam pelo index.php, que injeta as meta tags (SEO) no HTML
# inicial e serve o app React. Assets reais são servidos direto.

# index.php primeiro (pré-renderiza SEO); index.html como reserva.
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não reescrever arquivos e pastas que existem de verdade.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Arquivos estáticos AUSENTES (js/css/imagens/fontes) devem retornar 404 —
  # NUNCA cair no index.html, senão o navegador recebe HTML no lugar de JS e a
  # página fica em branco. Isso evita a "tela branca" quando os assets não
  # foram totalmente atualizados.
  RewriteRule \.(js|mjs|css|map|json|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|eot)$ - [L]

  # Demais rotas (/, /p/slug, /admin…) → index.php (SEO + app React).
  RewriteRule ^ index.php [L]
</IfModule>

# Cache dos assets versionados (hash no nome do arquivo).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# O HTML de entrada nunca é cacheado (novas versões e meta tags na hora).
<IfModule mod_headers.c>
  <FilesMatch "^index\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
