            {
              "id": "43886382",
              "elType": "widget",
              "widgetType": "html",
              "isInner": false,
              "settings": {
                "html": "<!-- ╔══════════════════════════════════════════════════════════╗\n     ║  STUDIO TABI — 05 FAQ                                    ║\n     ╚══════════════════════════════════════════════════════════╝ -->\n<style>\n  .tabi-faq *{box-sizing:border-box;}\n  .tabi-faq{background-color:#0D0D0D;font-family:'Be Vietnam Pro',sans-serif;position:relative;}\n  .tabi-faq__inner{padding:clamp(56px,9vw,120px) clamp(20px,4vw,82px);max-width:1400px;margin:0 auto;}\n  .tabi-faq__layout{display:grid;grid-template-columns:1fr;gap:clamp(32px,5vw,80px);align-items:start;}\n  .tabi-faq__left{opacity:0;transform:translateY(24px);transition:opacity .85s cubic-bezier(.16,1,.3,1),transform .85s cubic-bezier(.16,1,.3,1);}\n  .tabi-faq__left.is-visible{opacity:1;transform:translateY(0);}\n  .tabi-faq__eyebrow{display:flex;align-items:center;gap:10px;font-size:9px;font-weight:600;letter-spacing:.17em;color:rgba(239,239,239,.40);margin-bottom:clamp(20px,3vw,32px);}\n  .tabi-faq__eyebrow-dot{width:7px;height:7px;border-radius:50%;background-color:#F20C25;flex-shrink:0;}\n  .tabi-faq__headline{font-family:'Roboto Condensed',sans-serif;font-weight:900;font-size:clamp(38px,4.5vw,76px);letter-spacing:-.05em;text-transform:uppercase;margin:0 0 24px;line-height:.85;display:flex;flex-direction:column;gap:.06em;}\n  .tabi-faq__hl-wrap{overflow:hidden;line-height:.88;}\n  .tabi-faq__hl-line{display:block;color:#EFEFEF;transform:translateY(110%);transition:transform .9s cubic-bezier(.16,1,.3,1);}\n  .tabi-faq__hl-line--red{color:#F20C25;}\n  .tabi-faq__hl-line.is-visible{transform:translateY(0);}\n  .tabi-faq__sub{font-size:clamp(12px,.85vw,14px);font-weight:400;line-height:1.7;color:rgba(239,239,239,.42);margin-bottom:28px;}\n  .tabi-faq__btn{display:inline-flex;align-items:center;gap:10px;font-size:9.5px;font-weight:600;letter-spacing:.13em;color:#F20C25;background:transparent;border:none;cursor:pointer;font-family:'Be Vietnam Pro',sans-serif;padding:0;transition:gap .22s;}\n  .tabi-faq__btn:hover{gap:18px;}\n  .tabi-faq__right{}\n  .tabi-faq__item{position:relative;border-top:1px solid rgba(239,239,239,.10);opacity:0;transform:translateY(20px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1);}\n  .tabi-faq__item.is-visible{opacity:1;transform:translateY(0);}\n  .tabi-faq__item-bar{position:absolute;top:0;left:0;right:0;height:1px;transform-origin:left;transform:scaleX(0);transition:transform .5s cubic-bezier(.16,1,.3,1),background-color .3s;}\n  .tabi-faq__item.is-visible .tabi-faq__item-bar{transform:scaleX(1);}\n  .tabi-faq__trigger{width:100%;background:transparent;border:none;cursor:pointer;padding:clamp(22px,3vw,32px) 0;display:flex;align-items:center;justify-content:space-between;gap:24px;text-align:left;}\n  .tabi-faq__trigger-inner{display:flex;align-items:baseline;gap:16px;flex:1;}\n  .tabi-faq__idx{font-size:9px;font-weight:600;letter-spacing:.14em;flex-shrink:0;padding-top:2px;transition:color .25s;}\n  .tabi-faq__q{font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:clamp(15px,1.5vw,22px);letter-spacing:-.03em;text-transform:uppercase;color:rgba(239,239,239,.70);line-height:1.1;transition:color .25s;}\n  .tabi-faq__icon{font-family:'Roboto Condensed',sans-serif;font-weight:900;font-size:18px;color:rgba(239,239,239,.30);flex-shrink:0;line-height:1;transition:transform .3s cubic-bezier(.16,1,.3,1),color .25s;}\n  /* open state */\n  .tabi-faq__item--open .tabi-faq__idx{color:#F20C25;}\n  .tabi-faq__item--open .tabi-faq__q{color:#EFEFEF;}\n  .tabi-faq__item--open .tabi-faq__icon{transform:rotate(45deg);color:#F20C25;}\n  .tabi-faq__item--open .tabi-faq__item-bar{background-color:#F20C25;}\n  .tabi-faq__answer{overflow:hidden;max-height:0;transition:max-height .45s cubic-bezier(.16,1,.3,1);}\n  .tabi-faq__item--open .tabi-faq__answer{max-height:400px;}\n  .tabi-faq__answer-inner{font-size:clamp(13px,.95vw,16px);font-weight:400;line-height:1.72;color:rgba(239,239,239,.52);padding-bottom:clamp(22px,3vw,32px);padding-left:clamp(0px,2vw,36px);max-width:720px;}\n  .tabi-faq__bottom-line{height:1px;background-color:rgba(239,239,239,.10);}\n  @media(min-width:768px){\n    .tabi-faq__layout{grid-template-columns:4fr 8fr;}\n  }\n  @media(min-width:1024px){\n    .tabi-faq__left{position:sticky;top:clamp(80px,10vh,120px);}\n  }\n</style>\n\n<section class=\"tabi-faq\" id=\"tabiFaq\">\n  <div class=\"tabi-faq__inner\">\n    <div class=\"tabi-faq__layout\">\n\n      <div class=\"tabi-faq__left\" id=\"tabiFaqLeft\">\n        <div class=\"tabi-faq__eyebrow\">\n          <span class=\"tabi-faq__eyebrow-dot\"></span>\n          <span>STUDIO TABI &mdash; FAQ</span>\n        </div>\n        <h2 class=\"tabi-faq__headline\">\n          <span class=\"tabi-faq__hl-wrap\"><span class=\"tabi-faq__hl-line\" style=\"transition-delay:.05s\">PERGUNTAS</span></span>\n          <span class=\"tabi-faq__hl-wrap\"><span class=\"tabi-faq__hl-line\" style=\"transition-delay:.12s\">FREQUENTES</span></span>\n          <span class=\"tabi-faq__hl-wrap\"><span class=\"tabi-faq__hl-line tabi-faq__hl-line--red\" style=\"transition-delay:.19s\">.</span></span>\n        </h2>\n        <p class=\"tabi-faq__sub\">N&atilde;o encontrou o que procura? Entre em contato diretamente com a equipe.</p>\n        <button class=\"tabi-faq__btn\">FALAR COM A EQUIPE <span style=\"font-size:13px\">&#8594;</span></button>\n      </div>\n\n      <div class=\"tabi-faq__right\" id=\"tabiFaqRight\">\n        <div class=\"tabi-faq__item\" data-idx=\"1\">\n          <div class=\"tabi-faq__item-bar\" style=\"background-color:rgba(239,239,239,.20)\"></div>\n          <button class=\"tabi-faq__trigger\" aria-expanded=\"false\">\n            <div class=\"tabi-faq__trigger-inner\">\n              <span class=\"tabi-faq__idx\">01</span>\n              <span class=\"tabi-faq__q\">Como funciona o processo de trabalho?</span>\n            </div>\n            <span class=\"tabi-faq__icon\">+</span>\n          </button>\n          <div class=\"tabi-faq__answer\"><p class=\"tabi-faq__answer-inner\">Iniciamos com um diagn&oacute;stico aprofundado do neg&oacute;cio, mercado e objetivos. Em seguida, criamos um roadmap claro com entregas, prazos e marcos de aprova&ccedil;&atilde;o. Trabalhamos em sprints curtos com checkpoints semanais para garantir alinhamento cont&iacute;nuo &mdash; sem surpresas no final.</p></div>\n        </div>\n        <div class=\"tabi-faq__item\" data-idx=\"2\">\n          <div class=\"tabi-faq__item-bar\" style=\"background-color:rgba(239,239,239,.20)\"></div>\n          <button class=\"tabi-faq__trigger\" aria-expanded=\"false\">\n            <div class=\"tabi-faq__trigger-inner\">\n              <span class=\"tabi-faq__idx\">02</span>\n              <span class=\"tabi-faq__q\">Quanto tempo leva um projeto?</span>\n            </div>\n            <span class=\"tabi-faq__icon\">+</span>\n          </button>\n          <div class=\"tabi-faq__answer\"><p class=\"tabi-faq__answer-inner\">Depende do escopo. Um projeto de identidade visual leva de 3 a 6 semanas. Um site completo com design e desenvolvimento, de 6 a 12 semanas. Aplica&ccedil;&otilde;es mais complexas podem levar de 3 a 6 meses. Sempre apresentamos um cronograma detalhado antes de iniciar.</p></div>\n        </div>\n        <div class=\"tabi-faq__item\" data-idx=\"3\">\n          <div class=\"tabi-faq__item-bar\" style=\"background-color:rgba(239,239,239,.20)\"></div>\n          <button class=\"tabi-faq__trigger\" aria-expanded=\"false\">\n            <div class=\"tabi-faq__trigger-inner\">\n              <span class=\"tabi-faq__idx\">03</span>\n              <span class=\"tabi-faq__q\">Voc&ecirc;s trabalham com empresas de qual tamanho?</span>\n            </div>\n            <span class=\"tabi-faq__icon\">+</span>\n          </button>\n          <div class=\"tabi-faq__answer\"><p class=\"tabi-faq__answer-inner\">Atendemos desde startups em fase de crescimento at&eacute; empresas consolidadas que querem renovar sua presen&ccedil;a digital. O que importa n&atilde;o &eacute; o tamanho, mas o comprometimento com qualidade e a disposi&ccedil;&atilde;o para construir algo duradouro.</p></div>\n        </div>\n        <div class=\"tabi-faq__item\" data-idx=\"4\">\n          <div class=\"tabi-faq__item-bar\" style=\"background-color:rgba(239,239,239,.20)\"></div>\n          <button class=\"tabi-faq__trigger\" aria-expanded=\"false\">\n            <div class=\"tabi-faq__trigger-inner\">\n              <span class=\"tabi-faq__idx\">04</span>\n              <span class=\"tabi-faq__q\">Como &eacute; estruturada a precifica&ccedil;&atilde;o?</span>\n            </div>\n            <span class=\"tabi-faq__icon\">+</span>\n          </button>\n          <div class=\"tabi-faq__answer\"><p class=\"tabi-faq__answer-inner\">Trabalhamos com projetos fechados (escopo e valor definidos no in&iacute;cio) ou retainer mensal para empresas que precisam de parceria cont&iacute;nua. N&atilde;o cobramos por hora &mdash; cobramos pelo resultado. O or&ccedil;amento &eacute; apresentado de forma transparente, sem taxas ocultas.</p></div>\n        </div>\n        <div class=\"tabi-faq__item\" data-idx=\"5\">\n          <div class=\"tabi-faq__item-bar\" style=\"background-color:rgba(239,239,239,.20)\"></div>\n          <button class=\"tabi-faq__trigger\" aria-expanded=\"false\">\n            <div class=\"tabi-faq__trigger-inner\">\n              <span class=\"tabi-faq__idx\">05</span>\n              <span class=\"tabi-faq__q\">Voc&ecirc;s oferecem suporte ap&oacute;s a entrega?</span>\n            </div>\n            <span class=\"tabi-faq__icon\">+</span>\n          </button>\n          <div class=\"tabi-faq__answer\"><p class=\"tabi-faq__answer-inner\">Sim. Todos os projetos incluem um per&iacute;odo de garantia de 30 dias ap&oacute;s o lan&ccedil;amento. Para clientes que desejam suporte cont&iacute;nuo, oferecemos planos de manuten&ccedil;&atilde;o mensal que incluem atualiza&ccedil;&otilde;es, monitoramento e evolu&ccedil;&atilde;o do produto.</p></div>\n        </div>\n        <div class=\"tabi-faq__item\" data-idx=\"6\">\n          <div class=\"tabi-faq__item-bar\" style=\"background-color:rgba(239,239,239,.20)\"></div>\n          <button class=\"tabi-faq__trigger\" aria-expanded=\"false\">\n            <div class=\"tabi-faq__trigger-inner\">\n              <span class=\"tabi-faq__idx\">06</span>\n              <span class=\"tabi-faq__q\">Como posso come&ccedil;ar a trabalhar com voc&ecirc;s?</span>\n            </div>\n            <span class=\"tabi-faq__icon\">+</span>\n          </button>\n          <div class=\"tabi-faq__answer\"><p class=\"tabi-faq__answer-inner\">Preencha o formul&aacute;rio de contato ou nos envie um e-mail com um breve contexto do seu projeto. Agendaremos uma chamada de diagn&oacute;stico gratuita de 30 minutos para entender suas necessidades e verificar se somos o parceiro certo para voc&ecirc;.</p></div>\n        </div>\n        <div class=\"tabi-faq__bottom-line\"></div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  var sec=document.getElementById('tabiFaq');if(!sec)return;\n  // Reveal left panel\n  var left=document.getElementById('tabiFaqLeft');\n  if(left){\n    var lo=new IntersectionObserver(function(en){if(!en[0].isIntersecting)return;left.classList.add('is-visible');lo.disconnect();},{rootMargin:'-60px 0px'});\n    lo.observe(left);\n  }\n  // Reveal headline lines\n  sec.querySelectorAll('.tabi-faq__hl-line').forEach(function(el){\n    var o=new IntersectionObserver(function(en){if(!en[0].isIntersecting)return;el.classList.add('is-visible');o.disconnect();},{rootMargin:'-40px 0px'});\n    o.observe(el);\n  });\n  // Reveal + stagger items\n  sec.querySelectorAll('.tabi-faq__item').forEach(function(item,i){\n    var o=new IntersectionObserver(function(en){\n      if(!en[0].isIntersecting)return;\n      setTimeout(function(){item.classList.add('is-visible');},i*60);\n      o.disconnect();\n    },{rootMargin:'-40px 0px'});\n    o.observe(item);\n  });\n  // Accordion toggle\n  sec.querySelectorAll('.tabi-faq__trigger').forEach(function(btn){\n    btn.addEventListener('click',function(){\n      var item=btn.closest('.tabi-faq__item');\n      var isOpen=item.classList.contains('tabi-faq__item--open');\n      // close all\n      sec.querySelectorAll('.tabi-faq__item--open').forEach(function(el){el.classList.remove('tabi-faq__item--open');el.querySelector('.tabi-faq__trigger').setAttribute('aria-expanded','false');});\n      if(!isOpen){item.classList.add('tabi-faq__item--open');btn.setAttribute('aria-expanded','true');}\n    });\n  });\n})();\n</script>"
              },
              "elements": []
            }
          ]
        }
      ]
    }
  ],
  "page_settings": {}
}